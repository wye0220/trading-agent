{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trading-agent/MemoryCandidate.schema.json",
  "title": "MemoryCandidate",
  "description": "一条长期记忆的候选。statement 只由结构化字段组成，没有可以写入指令的自由文本。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "user_preference",
        "market_fact",
        "discipline_pattern"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{0,63}$"
        },
        "condition": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_.=<>]{0,63}$"
        },
        "metric": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "value": {
          "type": [
            "number",
            "integer",
            "boolean"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16
        },
        "sample_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "source": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "subject",
        "metric",
        "value",
        "source"
      ]
    },
    "source_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "maxItems": 50
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "kind",
    "scope",
    "statement",
    "source_event_ids"
  ]
}
