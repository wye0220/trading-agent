{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trading-agent/MemoryCandidate.schema.json",
  "title": "MemoryCandidate",
  "description": "一条长期记忆的候选。statement 只由结构化字段组成；每个字符串字段是枚举或固定文法，没有可以写入指令的自由文本。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "user_preference",
        "market_fact",
        "discipline_pattern"
      ]
    },
    "scope": {
      "type": "string",
      "pattern": "^(global|[a-z][a-z0-9_]{0,31}:[A-Z][A-Z0-9]{0,7}:(RTH|ETH):[0-9]{1,3}[mhd])$"
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{0,63}$"
        },
        "condition": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_.=<>]{0,63}$"
        },
        "metric": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "value": {
          "type": [
            "number",
            "boolean"
          ]
        },
        "unit": {
          "enum": [
            null,
            "s",
            "yyyymmdd",
            "ratio",
            "r",
            "count"
          ]
        },
        "sample_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000000
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.\\.[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "source": {
          "enum": [
            "trader_note",
            "session_review",
            "evolve_cluster",
            "manual_ledger",
            "exchange_calendar",
            "instrument_config"
          ]
        }
      },
      "required": [
        "subject",
        "condition",
        "metric",
        "value",
        "unit",
        "sample_n",
        "period",
        "source"
      ]
    },
    "source_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_:.\\-]{0,119}$"
      },
      "maxItems": 50,
      "uniqueItems": true
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "required": [
    "kind",
    "scope",
    "statement",
    "source_event_ids",
    "valid_until"
  ]
}
