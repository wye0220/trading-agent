{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trading-agent/Candidate.schema.json",
  "title": "Candidate",
  "description": "一个可验证的改动候选。exact_diff 只能是白名单内的结构化差异，不能触及风险上限、权限或评测协议。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "enum": [
        "OBSERVATION",
        "PROPOSED"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "category": {
      "enum": [
        "strategy_rule",
        "explanation_discipline",
        "data_engine",
        "memory"
      ]
    },
    "eval_track": {
      "enum": [
        "PRUNING_DEFENSIVE",
        "ALPHA_EXPANSION",
        "CHEAP_NON_STRATEGY"
      ]
    },
    "base_release": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "evidence_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "maxItems": 50
    },
    "evidence_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "maxItems": 60
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "maxItems": 50
    },
    "observed_problem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "exact_diff": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "enum": [
              "strategy_config",
              "rule_switch",
              "template_file"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "from": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "to": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "target",
          "key",
          "from",
          "to"
        ]
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "maxItems": 10
    },
    "primary_metric": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "minimum_effect": {
      "type": "number"
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "maxItems": 10
    },
    "evaluation_protocol_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "expected_tradeoff": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "rollback_trigger": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    }
  },
  "required": [
    "candidate_id",
    "status",
    "scope",
    "category",
    "eval_track",
    "evidence_event_ids",
    "evidence_dates",
    "observed_problem",
    "hypothesis",
    "exact_diff",
    "primary_metric",
    "rollback_trigger"
  ]
}
