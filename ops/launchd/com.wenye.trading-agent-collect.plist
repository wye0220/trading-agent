<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wenye.trading-agent-collect</string>

  <!-- trading-agent 每日期货 K 线采集：周一到周五 17:12（纽约时间，CME 收盘后）取 ES、NQ 当天的 5 分钟线。
       只读行情。失败或授权失效时发 Telegram。脚本自己判断交易日，休市日安静退出。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/wenye/trading-agent/ops/launchd/run-collect-mcp.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/wenye/trading-agent</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/wenye/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>/Users/wenye</string>
    <key>USER</key><string>wenye</string>
    <key>LOGNAME</key><string>wenye</string>
    <key>TZ</key><string>America/New_York</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>12</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>12</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>12</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>12</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>12</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/trading-agent-collect-mcp.out</string>
  <key>StandardErrorPath</key><string>/tmp/trading-agent-collect-mcp.err</string>
</dict>
</plist>
