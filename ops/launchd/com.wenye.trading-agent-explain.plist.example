<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  样例，未安装（阶段 10）。交易日 16:30：claude -p 处理解释请求（没有工具，输出过 schema；失败进死信）。
  安装（要你授权）：cp 到 ~/Library/LaunchAgents/（去掉 .example），然后
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.wenye.trading-agent-explain.plist
  停用：launchctl bootout gui/$(id -u)/com.wenye.trading-agent-explain
  等价的手工命令见 docs/ops-runbook.md。
-->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.wenye.trading-agent-explain</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/wenye/trading-agent/ops/launchd/run-ops.sh</string>
        <string>explain</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/wenye/trading-agent</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>TZ</key><string>America/New_York</string>
        <key>PATH</key><string>/Users/wenye/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
    </array>
    <key>RunAtLoad</key><false/>
</dict>
</plist>
