<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  样例，未安装（阶段 10）。每 2 分钟检查 watch 心跳；盘中停了就记 CRITICAL 并推送。
  安装（要你授权）：cp 到 ~/Library/LaunchAgents/（去掉 .example），然后
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.wenye.trading-agent-watch-check.plist
  停用：launchctl bootout gui/$(id -u)/com.wenye.trading-agent-watch-check
  等价的手工命令见 docs/ops-runbook.md。
-->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.wenye.trading-agent-watch-check</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/wenye/trading-agent/ops/launchd/run-ops.sh</string>
        <string>watch-check</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/wenye/trading-agent</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>TZ</key><string>America/New_York</string>
        <key>PATH</key><string>/Users/wenye/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartInterval</key><integer>120</integer>
    <key>RunAtLoad</key><false/>
</dict>
</plist>
